# npm start's local settings. Copy this file to .env.local (gitignored) and fill in only what you
# need: with nothing set, the app runs with text input and no voice. Names only here; values
# never go into the repo. npm start generates DEMO_OWNER_PASSWORD and VOICE_AGENT_SECRET into
# .env.local on its first run.

# Voice: on only when all five are set.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=

# Optional extras.
# OPENROUTER_MODEL=            the agent's LLM, default anthropic/claude-haiku-5.5
# AGENT_NAME=                  the voice worker's name in the LiveKit project, default voice-assistant
# VOICE_SESSIONS_PER_DAY=      default 20
# VOICE_MAX_SECONDS=           default 300
# AUTH_RESEND_KEY=             password-reset emails through Resend
# AUTH_EMAIL_FROM=             their sender, such as "My App <no-reply@your-domain>"
# OWNER_EMAILS=                more owners besides the demo one, comma-separated
# DEMO_OWNER_EMAIL=            default demo@example.com
