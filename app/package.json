{
  "name": "client-app-starter",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit && tsc -p convex --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run check:english && npm run check:colors && npm run knip && npm test",
    "check:colors": "! grep -rnE '#[0-9a-fA-F]{3,8}\\b|rgba?\\(' src --include='*.ts' --include='*.tsx' --include='*.css' | grep -v -e '^src/ui/' -e '^src/appTokens.css:'",
    "check:english": "tsx scripts/check-english.ts",
    "knip": "knip",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:backend": "tsx e2e/localBackend.ts",
    "convex:dev": "convex dev",
    "deploy:convex": "convex deploy",
    "deploy:web": "npm run build && wrangler deploy",
    "deploy": "npm run deploy:convex && npm run deploy:web",
    "prove:owner": "tsx scripts/prove-owner-path.ts",
    "feedback": "tsx scripts/feedback.ts",
    "backup:prod": "tsx scripts/backup.ts --prod"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/migrations": "^0.3.7",
    "@livekit/components-react": "^2.9.24",
    "@oslojs/crypto": "^1.0.1",
    "convex": "^1.47.0",
    "convex-helpers": "^0.1.128",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.60",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
