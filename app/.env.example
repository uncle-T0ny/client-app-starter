# Frontend (Vite). `npx convex dev` writes these into .env.local for you;
# copy this file to .env.local only when you set a deployment up by hand.
CONVEX_DEPLOYMENT=dev:<deployment-name>
VITE_CONVEX_URL=https://<deployment-name>.convex.cloud

# Production build: create .env.production (not committed) with your prod URL only:
#   VITE_CONVEX_URL=https://<prod-deployment-name>.convex.cloud
# `vite build` reads it, so `npm run build` and `npm run deploy:web` target prod.

# Backend settings are NOT read from any .env file. Convex functions read them
# from the deployment's environment variables: the dashboard, Settings >
# Environment Variables, or `npx convex env set NAME value` (add --prod for production).
#   OWNER_EMAILS      comma-separated emails allowed to sign up as an owner
#   AUTH_RESEND_KEY   Resend API key for password-reset emails (secret, never commit it)
#   AUTH_EMAIL_FROM   the reset email's sender, e.g. "My App <no-reply@your-domain>"
#   SITE_URL          the app's URL (http://localhost:5173 in dev)
#   JWT_PRIVATE_KEY   Convex Auth signing key, set by `npx @convex-dev/auth`
#   JWKS              Convex Auth public keys, set by `npx @convex-dev/auth`
#   ALLOW_TEST_FUNCTIONS  dev and e2e only: "true" turns on convex/testing.ts. Never on prod.

# e2e (optional): comma-separated names of cloud deployments the suite must refuse to touch.
#   E2E_SHARED_DEPLOYMENTS=<dev-deployment-name>,<prod-deployment-name>
