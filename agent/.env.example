# The agent worker's settings. Copy this file to .env.local (gitignored) for `npm run dev`;
# on LiveKit Cloud they are the agent's secrets. Names only here: values never go in the repo.

# `npm start` at the repo root runs this worker for you, with these from the root .env.local;
# this file is for running it on its own (`npm run dev` here).

# The LiveKit project the worker registers with. The Convex deployment has the same three, to
# mint the browser's token.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The worker's name in that project (default voice-assistant). The Convex deployment's
# AGENT_NAME must be the same: its tokens dispatch that name. Give each worker sharing one
# LiveKit project its own name.
AGENT_NAME=

# Speech through Deepgram's plugin: Nova-3 listens, Aura-2 (Thalia) speaks.
DEEPGRAM_API_KEY=

# The LLM, through OpenRouter's OpenAI-compatible API. The model defaults to
# anthropic/claude-haiku-5.5 when OPENROUTER_MODEL is empty.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Where the transcript goes: the Convex deployment's HTTP actions URL
# (https://<deployment-name>.convex.site), and the secret it checks. The Convex deployment has
# the same VOICE_AGENT_SECRET.
CONVEX_SITE_URL=
VOICE_AGENT_SECRET=

# The longest a session may run, in seconds (default 300). The agent says goodbye and leaves.
VOICE_MAX_SECONDS=
