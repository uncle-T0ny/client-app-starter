{
  "name": "client-app-starter-agent",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local src/main.ts dev",
    "start": "node src/main.ts start",
    "download-files": "livekit-agents download-files",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.3",
    "@livekit/agents-plugin-openai": "^1.9.3",
    "@livekit/agents-plugin-silero": "^1.9.3",
    "@livekit/rtc-node": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
